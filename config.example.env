# Salin jadi .env lalu isi. Dibaca oleh run.sh.

# ── Sisi Satuchat → bridge ───────────────────────────────────────────────────
# Token ini ikut di URL node API Call, karena node itu tidak bisa mengirim
# header custom. Perlakukan URL tunnel + token sebagai satu rahasia.
BRIDGE_TOKEN=ganti-dengan-token-acak-panjang

BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787

# ── Sisi bridge → Satuchat ───────────────────────────────────────────────────
# Base URL API Satuchat, termasuk /api/v1 (TANPA /bridge di belakang).
SATUCHAT_API_BASE=https://api.satuchat.example/api/v1
# Harus sama persis dengan BRIDGE_API_KEY di .env backend Satuchat (min 32 char).
SATUCHAT_BRIDGE_KEY=ganti-dengan-kunci-yang-sama-di-backend

# ── Sisi Hermes ──────────────────────────────────────────────────────────────
HERMES_BIN=hermes
# Folder kerja agen. Biarkan default kalau tidak yakin.
# HERMES_CWD=/Users/namamu
# Batas satu giliran agen. Generate PO + convert PDF bisa ~60 detik; 600 detik
# memberi ruang untuk percakapan yang panjang tanpa menggantung selamanya.
HERMES_TIMEOUT=600
HERMES_SESSION_PREFIX=wa-

# BRIDGE_STATE_FILE=/Users/namamu/.prpo-bridge/sessions.json
# BRIDGE_LOG_LEVEL=INFO

# ── Dipakai build_flow.py saat menghasilkan canvas Flow Builder ──────────────
# URL publik bridge (hasil tunnel). Beda dari BRIDGE_HOST/PORT di atas: yang itu
# alamat lokal yang didengarkan, yang ini alamat yang ditulis ke node API Call.
BRIDGE_PUBLIC_URL=https://xxx.trycloudflare.com
# Nomor tim purchasing yang boleh memakai flow, dipisah koma.
FLOW_NOMOR_DIIZINKAN=+6282360599486
FLOW_REVIEW_URL=https://psggroup.co.id/review-dokumen
# Kosongkan untuk memakai AI agent default channel.
FLOW_AI_AGENT_ID=
